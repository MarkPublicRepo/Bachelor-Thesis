	doi = {10.1007/978-3-031-30872-7_16},
	abstract = {We advocate for a post-quantum cryptography strategy for DNSSEC that includes two types of algorithms: a conserva)vely designed algorithm that is unlikely ever to need to be replaced, and a lowimpact drop-in algorithm that is used the same way as a tradiZonal signature algorithm. The conservaZvely designed algorithm would be used in a mode of opera)on that miZgates the operaZonal impact of a large signature size. The combinaZon provides both the rou)ne performance of the lowimpact algorithm and a resilient fallback to the conservaZvely designed choice. We detail our strategy for DNSSEC and outline next steps for tesZng it.},
	language = {en},
	urldate = {2026-08-14},
