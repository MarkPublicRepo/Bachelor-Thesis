@article{mullerRetrofittingPostquantumCryptography2020,
  title = {Retrofitting Post-Quantum Cryptography in Internet Protocols: A Case Study of {{DNSSEC}}},
  shorttitle = {Retrofitting Post-Quantum Cryptography in Internet Protocols},
  author = {M{\"u}ller, Moritz and {de Jong}, Jins and {van Heesch}, Maran and Overeinder, Benno and {van Rijswijk-Deij}, Roland},
