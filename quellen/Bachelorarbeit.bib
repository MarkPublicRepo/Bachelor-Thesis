	pages = {415--441},
	file = {PDF:/home/Mark/Zotero/storage/QM7MYSZZ/Fregly et al. - 2023 - Merkle Tree Ladder Mode Reducing the Size Impact of NIST PQC Signature Algorithms in Practice.pdf:application/pdf},
}

